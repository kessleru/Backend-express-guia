// O SCHEMA — a fonte de verdade do banco no Prisma.
//
// Este arquivo substitui as migrations escritas à mão do módulo 09. Você
// descreve o estado DESEJADO; o `prisma migrate` calcula o SQL que leva o banco
// do estado atual até ele.
//
// Ele vive no git, junto do código que depende dele — schema e código sempre na
// mesma versão. É o mesmo princípio das migrations do módulo 09.

generator client {
  // No Prisma 7 o gerador padrão é `prisma-client` (ESM, TypeScript de verdade),
  // e ele EXIGE um `output`. O antigo `prisma-client-js`, que escrevia dentro de
  // node_modules, está a caminho da aposentadoria.
  provider = "prisma-client"
  output   = "../src/exemplos/06-10/10-prisma/gerado"

  // `runtime` diz para qual ambiente gerar. `nodejs` é o nosso caso.
  runtime = "nodejs"
}

datasource db {
  provider = "sqlite"
  // No Prisma 7 a URL NÃO mora mais aqui — ela foi para `prisma.config.ts`.
  // Motivo: o schema é sobre a FORMA dos dados; conexão é configuração de
  // runtime. Antes, `url = env("DATABASE_URL")` misturava as duas coisas, e o
  // schema precisava do .env presente até para gerar o client.
}

// ---------------------------------------------------------------------
// MODELOS
// ---------------------------------------------------------------------

model Autor {
  id            Int       @id @default(autoincrement())
  nome          String
  nacionalidade String
  nascimento    DateTime? // `?` = opcional; no banco, NULL
  criadoEm      DateTime  @default(now()) @map("criado_em")

  // A relação. Este campo NÃO existe como coluna no banco — é o Prisma
  // permitindo navegar de autor para livros. Quem tem a coluna é `Livro.autorId`.
  livros Livro[]

  // `@@map` separa o nome do MODELO (usado no código, PascalCase) do nome da
  // TABELA (usado no SQL, snake_case). Sem isso, sua convenção de TypeScript
  // acaba ditando a do banco.
  @@map("autores")
}

model Livro {
  id         Int     @id @default(autoincrement())
  titulo     String
  ano        Int
  isbn       String? @unique // opcional e único: vários NULL são permitidos
  disponivel Boolean @default(true) // o Prisma converte para 0/1 no SQLite

  autorId Int   @map("autor_id")
  // `onDelete: Restrict` é a mesma regra do módulo 09: recusa apagar autor com
  // livros. As opções são Restrict, Cascade, SetNull e NoAction.
  autor   Autor @relation(fields: [autorId], references: [id], onDelete: Restrict)

  // N-N com tabela de junção EXPLÍCITA (`LivroGenero`).
  //
  // O Prisma também sabe fazer N-N implícito (`generos Genero[]` dos dois lados,
  // e ele cria a tabela sozinho). Escolhi explícita porque:
  //   1. você vê a tabela que o módulo 09 criou à mão, e a correspondência fica clara
  //   2. dá para adicionar colunas na junção depois (ex.: `principal Boolean`)
  // O implícito é mais curto e você não consegue acrescentar nada nele.
  generos     LivroGenero[]
  emprestimos Emprestimo[]

  @@index([autorId])
  @@index([disponivel])
  @@map("livros")
}

model Genero {
  id     Int           @id @default(autoincrement())
  nome   String        @unique
  livros LivroGenero[]

  @@map("generos")
}

/// O mesmo `Curso` dos módulos 08 e 09, para o servidor de exemplo reusar o
/// service e as rotas de lá sem nenhuma adaptação.
///
/// `@@unique` no título com `mode: insensitive` não existe no SQLite (é um
/// recurso do Postgres), então a unicidade case-insensitive continua sendo regra
/// do service aqui — exemplo de "o ORM não esconde as diferenças entre bancos".
model Curso {
  id        Int     @id @default(autoincrement())
  titulo    String  @unique
  horas     Int
  publicado Boolean @default(false)

  @@index([publicado])
  @@map("cursos")
}

model LivroGenero {
  livroId  Int @map("livro_id")
  generoId Int @map("genero_id")

  livro  Livro  @relation(fields: [livroId], references: [id], onDelete: Cascade)
  genero Genero @relation(fields: [generoId], references: [id], onDelete: Restrict)

  // Chave primária COMPOSTA — o mesmo `PRIMARY KEY (livro_id, genero_id)` do
  // módulo 09. O par é único, então o gênero não se repete no mesmo livro.
  @@id([livroId, generoId])
  @@map("livros_generos")
}

// ---------------------------------------------------------------------
// MÓDULO 11 — AUTENTICAÇÃO
// ---------------------------------------------------------------------
// Os três modelos abaixo não pertencem ao exemplo do módulo 10: eles entram
// para as SOLUÇÕES dos exercícios 11, 12 e 13, que até aqui rodavam com
// repositórios em memória e por isso perdiam tudo no restart.
//
// Eles moram neste mesmo schema de propósito. Um projeto Prisma tem um schema,
// um client gerado e um histórico de migrations; criar um segundo só para os
// exercícios significaria duplicar os três e obrigar quem estuda o módulo 11 a
// configurar um projeto Prisma antes de aprender autenticação. O custo aceito
// é o inverso: o banco do exemplo 10 passa a ter tabelas que aquele módulo não
// usa. Elas ficam separadas por estes cabeçalhos.

/// Usuário da biblioteca (módulo 11).
model Usuario {
  id    Int    @id @default(autoincrement())
  email String @unique

  /// O campo se chama `senhaHash`, nunca `senha` — o nome denuncia na leitura
  /// quem tentar gravar texto puro aqui. Ver `dominio/usuario.ts`.
  senhaHash String @map("senha_hash")

  /// `String`, e não um `enum` do Prisma, porque **SQLite não tem enum** e o
  /// Prisma recusa `enum` neste provider. Quem garante o conjunto fechado
  /// (`leitor` | `admin`) é o tipo `Papel` no TypeScript.
  ///
  /// É um exemplo direto do que o módulo 10 promete: o ORM não apaga as
  /// diferenças entre bancos. Em Postgres esta linha seria `papel Papel`, com
  /// a validação descendo para o banco.
  papel String @default("leitor")

  criadoEm DateTime @default(now()) @map("criado_em")

  emprestimos Emprestimo[]
  refreshes   RefreshToken[]

  @@map("usuarios")
}

/// Empréstimo de um livro por um usuário (módulo 11).
///
/// Até o módulo 10 "emprestado" era um booleano dentro do livro. A partir do
/// momento em que existe autorização por dono, o empréstimo precisa ser entidade
/// própria: sem `usuarioId` não há como responder "este empréstimo é seu?".
model Emprestimo {
  id Int @id @default(autoincrement())

  livroId   Int @map("livro_id")
  usuarioId Int @map("usuario_id")

  pegoEm DateTime @default(now()) @map("pego_em")

  /// `null` = ainda está com o usuário. É o que define "empréstimo aberto", e é
  /// por isso que a busca do módulo 13 filtra por `devolvidoEm: null`.
  devolvidoEm DateTime? @map("devolvido_em")

  /// `Restrict` nos dois lados: apagar um livro ou um usuário que tem histórico
  /// de empréstimo é recusado pelo banco. `Cascade` apagaria o histórico junto —
  /// e histórico de empréstimo é justamente o que uma biblioteca não pode perder.
  livro   Livro   @relation(fields: [livroId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  /// O índice que a regra de dono exige: `listarPorUsuario` roda em toda tela de
  /// "meus empréstimos". Sem ele, cada abertura varre a tabela inteira.
  @@index([usuarioId])
  /// E este serve a `buscarAbertoPorLivro`, chamada em toda devolução.
  @@index([livroId, devolvidoEm])
  @@map("emprestimos")
}

/// Refresh tokens ainda válidos, indexados pelo `jti` (módulo 11).
///
/// Esta tabela é o que torna o logout possível. Um JWT assinado é
/// auto-suficiente: não existe "invalidar" um. A saída é guardar do lado do
/// servidor o identificador do token e conferi-lo — reintroduzindo o estado que
/// o JWT prometia eliminar, mas só a cada 15 minutos, não a cada requisição.
///
/// Em produção isto costuma ser um Redis com TTL, e não uma tabela: a linha
/// morre sozinha na expiração, sem job de limpeza. Módulo 15.
model RefreshToken {
  /// O `jti` do JWT é a chave primária — não há id artificial, porque o token
  /// já traz um identificador único e é por ele que a busca sempre acontece.
  jti String @id

  usuarioId Int      @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  /// `Cascade` aqui, ao contrário dos empréstimos: apagar o usuário deve apagar
  /// as sessões dele. Sessão órfã não é histórico, é credencial pendurada.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// `revogarDoUsuario` (usado no "trocar senha") apaga por `usuarioId`.
  @@index([usuarioId])
  @@map("refresh_tokens")
}
