// Config para checar os tipos das soluções dos exercícios, que ficam fora
// de src/. Uso: npm run typecheck:ex
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `rootDir` é a raiz do repo, não `./exercicios`: a solução do módulo 10
    // importa o Prisma Client gerado em `src/exemplos/06-10/10-prisma/gerado/`, e um
    // `rootDir` mais estreito recusaria arquivo fora dele (TS6059). Como aqui é
    // só `--noEmit`, `rootDir` não decide layout de saída nenhum.
    "rootDir": ".",
    "noEmit": true,
    // Sem emissão, gerar declaração e sourcemap é trabalho jogado fora.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["exercicios/**/*.ts"],
  "exclude": []
}
